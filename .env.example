# ==============================================================================
# AprendIDos - Exemplo de Variáveis de Ambiente (.env.example)
# Copie este arquivo para .env e preencha com os valores do seu projeto Supabase.
# ATENÇÃO: NUNCA coloque a SERVICE_ROLE KEY em arquivos frontend.
# ==============================================================================

# URL pública do projeto Supabase (Project Settings > API)
SUPABASE_URL=https://seu-projeto.supabase.co

# Chave pública anônima (anon public key) do Supabase (Project Settings > API)
SUPABASE_ANON_KEY=sua_chave_anon_ou_publishable_aqui
