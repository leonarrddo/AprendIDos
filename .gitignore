# ==============================================================================
# AprendIDos - Arquivo de Bloqueio do Git (.gitignore)
# Protege segredos, variáveis de ambiente e arquivos temporários
# ==============================================================================

# Dependências
node_modules/
package-lock.json

# Variáveis de Ambiente e Segredos (CRÍTICO - NUNCA ENVIAR PARA O GIT)
.env
.env.local
.env.*.local
*.pem
*.key

# Logs e arquivos de depuração
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# Arquivos do Sistema Operacional
.DS_Store
Thumbs.db
desktop.ini

# Arquivos de IDEs e Editores
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
